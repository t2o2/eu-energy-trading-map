# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# generated at build time by `npm run snapshot`. The snapshot itself is tracked:
# it is the last-known-good the build falls back on when ENTSO-E is unavailable,
# and CI commits a fresh one back whenever a fetch is healthy. Negating a path
# needs the /* form — git will not descend into an ignored directory.
/public/data/*
!/public/data/snapshot.json

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
tsconfig.tsbuildinfo
