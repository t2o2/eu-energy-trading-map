# ENTSO-E Transparency Platform security token.
# Register at https://transparency.entsoe.eu, then email transparency@entsoe.eu
# from the registered address with subject "Restful API access". Approval is manual.
# Without this the app serves simulated data.
ENTSOE_TOKEN=

# Force simulated data even when a token is present.
# DATA_SOURCE=mock

# CARTO basemap key, from https://carto.com/basemaps/apikey
# Vector tiles do not require it yet; CARTO has said the requirement is coming,
# so we send it already. Without it the map still renders today.
# This is a browser key: it ships in the client bundle and is visible in every
# tile request. Keep it out of git, but do not treat it as a secret.
NEXT_PUBLIC_CARTO_BASEMAP_KEY=
